{
  "name": "egypt-nutrition-coach",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run build && npx wrangler deploy --config wrangler.jsonc",
    "deploy:d1": "npx wrangler d1 migrations apply egypt-nutrition-coaching --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "test:browser": "node scripts/browser-onboarding.mjs && node scripts/browser-smoke.mjs && node scripts/browser-audit.mjs && node scripts/browser-simulation.mjs && node scripts/browser-coaching-journey.mjs",
    "check": "node scripts/check-data-manifest.mjs && npm run build && npm test",
    "audit:matrix": "node scripts/audit-matrix.mjs",
    "benchmark": "node scripts/benchmark-load.mjs",
    "data:manifest": "node scripts/check-data-manifest.mjs --write",
    "test:browser:release": "node scripts/browser-release-011.mjs",
    "sim:100:90": "node scripts/cohort/run.mjs",
    "sim:verify": "node scripts/cohort/verify.mjs",
    "sim:report": "node scripts/cohort/report.mjs",
    "sim:stress": "node scripts/cohort/stress.mjs",
    "sim:serve": "node scripts/cohort/serve.mjs",
    "sim:browser": "node scripts/cohort/browser.mjs",
    "sim:compare": "node scripts/cohort/compare.mjs",
    "sim:fast": "node scripts/run-full-simulation.mjs",
    "sim:fast:verify": "node scripts/verify-simulation.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@playwright/test": "1.56.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
