{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curafit-api",
  "main": "dist/server/cloudflare.js",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ENFORCE_PRO_ENTITLEMENTS": "true",
    "ENABLE_OPENFOODFACTS": "true",
    "STRICT_STORE_VERIFICATION": "true",
    "MIN_ANDROID_VERSION": "1.0.0",
    "MIN_IOS_VERSION": "1.0.0",
    "LATEST_ANDROID_VERSION": "1.0.0",
    "LATEST_IOS_VERSION": "1.0.0"
  },
  // Prerequisite: enable R2 in Cloudflare Dashboard (account 7a3acfb886853d23106e93102fb81731),
  // then run `wrangler r2 bucket create curafit-media-prod` & `curafit-media-dev` and uncomment below:
  // "r2_buckets": [{ "binding": "CURAFIT_MEDIA_BUCKET", "bucket_name": "curafit-media-prod" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "egypt-nutrition-coaching",
      "database_id": "90fa62f1-7866-4156-ac29-f0aec4814bab",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "dev": {
      "name": "curafit-api-dev",
      "workers_dev": true,
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "vars": {
        "ENFORCE_PRO_ENTITLEMENTS": "false",
        "ENABLE_OPENFOODFACTS": "true",
        "STRICT_STORE_VERIFICATION": "false",
        "MIN_ANDROID_VERSION": "1.0.0",
        "MIN_IOS_VERSION": "1.0.0",
        "LATEST_ANDROID_VERSION": "1.0.0",
        "LATEST_IOS_VERSION": "1.0.0"
      },
      // Uncomment after enabling R2 in Cloudflare Dashboard and creating `curafit-media-dev`:
      // "r2_buckets": [{ "binding": "CURAFIT_MEDIA_BUCKET", "bucket_name": "curafit-media-dev" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "curafit-db-dev",
          "database_id": "0a6b8bf6-8491-4ca1-95fd-e1c00430e3d0",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
